---
import Layout from '../../layouts/Layout.astro';
import DeviceFrame from '../../components/DeviceFrame.astro';
import CoverArt from '../../components/CoverArt.astro';
import siteData from '../../../data.json';

export function getStaticPaths() {
  return siteData.projects.map((project: any) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: any };
const catLabel = project.category === 'flutter' ? 'Flutter App' : 'Web Project';
const cs = project.caseStudy;
---
<Layout title={`${project.name} — SA3DWY`}>
  <a href="/projects" class="btn btn-ghost btn-sm reveal" style="margin-bottom:10px;">→ رجوع للمشاريع</a>

  <section class="case-hero reveal">
    <span class={`case-hero__cat ${project.category}`}>{catLabel}</span>
    <h1 class="case-hero__title">{project.name}</h1>
    <p class="case-hero__tagline">{project.tagline}</p>
    <span class="case-status"><span class="dot"></span>{project.status}</span>
  </section>

  {project.category === 'flutter' ? (
    <div class="case-gallery reveal-group">
      {[1, 2, 3].map((v: any) => (
        <div class="frame-shot reveal">
          <DeviceFrame project={project} variant={v as 1 | 2 | 3} size="large" />
        </div>
      ))}
    </div>
  ) : (
    <div class="case-gallery is-web reveal-group">
      <div class="frame-shot reveal" style="aspect-ratio:16/9; grid-column: 1 / -1;">
        <CoverArt icon={project.coverIcon} label={project.name} tone={project.coverTone} />
      </div>
    </div>
  )}

  <div class="case-grid reveal-group">
    <div class="case-card reveal">
      <h3>المشكلة</h3>
      <p>{cs.problem}</p>
    </div>
    <div class="case-card reveal">
      <h3>الحل والتنفيذ</h3>
      <p>{cs.approach}</p>
    </div>
    <div class="case-card reveal">
      <h3>أهم الميزات</h3>
      <ul class="case-list">
        {cs.features.map((f: string) => <li>{f}</li>)}
      </ul>
    </div>
    <div class="case-card reveal">
      <h3>النتيجة والتعلم</h3>
      <p>{cs.result}</p>
    </div>
  </div>

  <div class="reveal" style="margin-top:30px;">
    <h3 style="font-family:var(--font-mono); font-size:0.95rem; color:var(--gold); margin-bottom:14px;">التقنيات المستخدمة</h3>
    <div class="tag-wrap">
      {project.tech.map((t: string) => <span class="tag">{t}</span>)}
    </div>
  </div>

  <div class="case-actions reveal">
    {project.links?.demo && (
      <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Live Demo</a>
    )}
    <a href="/projects" class="btn btn-ghost">كل المشاريع</a>
    <a href="/contact" class="btn btn-soft">تواصل معايا بخصوص المشروع ده</a>
  </div>
</Layout>
