---
import Layout from '../layouts/Layout.astro';
import data from '../../data.json';
---
<Layout title="SA3DWY | تواصل معي">
    <section id="contact">
        <h2 class="section-title fade-in-up">تواصل معي</h2>
        <p class="section-subtitle fade-in-up" style="animation-delay: 100ms;">يمكنك متابعتي والتواصل معي عبر المنصات التالية</p>
        <div class="social-links-grid">
            {data.socialLinks.map((link, index) => (
                <a href={link.url} target="_blank" class="social-card fade-in-up" style={`animation-delay: ${200 + index * 100}ms`}>
                    <img src={link.icon} alt={link.name + " icon"} />
                    <span>{link.name}</span>
                </a>
            ))}
        </div>
    </section>
</Layout>