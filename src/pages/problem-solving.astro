---
import Layout from '../layouts/Layout.astro';
import data from '../../data.json';
const { problemSolving } = data;
---

<Layout title="SA3DWY | حل المشاكل">
  <section id="problem-solving">
    <h2 class="section-title fade-in-up">حل المشاكل البرمجية</h2>
    <p class="section-subtitle fade-in-up" style="animation-delay: 100ms;">
      مجموعة من حلول المشاكل التي قمت بحلها على منصات مختلفة.
    </p>

    {problemSolving.map((group, groupIndex) => (
      <div class="platform-group fade-in-up" style={`animation-delay: ${200 + groupIndex * 100}ms`}>
        <h3 class="platform-title">
          <img src={group.platformIcon} alt={group.platform} />
          {group.platform}
        </h3>
        <div class="problems-list">
          {group.problems.map((problem, problemIndex) => (
            <div class="problem-card" data-repo={problem.repo} data-path={problem.filePath}>
              <span class="problem-title">{problem.title}</span>
              <button class="btn-view-code">عرض الكود</button>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>

<div id="code-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <button id="close-modal" class="modal-close-btn">&times;</button>
    <div id="modal-code-content">
      <pre><code id="code-block" class="language-cpp"></code></pre>
    </div>
  </div>
</div>

<script>
  // الحصول على العناصر
  const viewCodeButtons = document.querySelectorAll('.btn-view-code');
  const modal = document.getElementById('code-modal');
  const closeModalBtn = document.getElementById('close-modal');
  const codeBlock = document.getElementById('code-block');
  const modalContent = document.getElementById('modal-code-content');

  // دالة لفتح النافذة
  async function openModal(repo, path) {
    modal.style.display = 'flex';
    modalContent.innerHTML = '<p class="loading-text">جاري تحميل الكود...</p>';

    try {
      // استدعاء ה-API Route الذي أنشأته
      const response = await fetch(`/api/getCode?repo=${repo}&path=${path}`);
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || 'فشل في جلب الكود');
      }

      // GitHub API ترسل المحتوى بصيغة Base64, يجب فك تشفيرها
      const decodedContent = atob(data.content);

      modalContent.innerHTML = `<pre><code id="code-block" class="language-cpp">${escapeHtml(decodedContent)}</code></pre>`;

    } catch (error) {
      modalContent.innerHTML = `<p class="error-text">حدث خطأ: ${error.message}</p>`;
    }
  }

  // دالة لإغلاق النافذة
  function closeModal() {
    modal.style.display = 'none';
  }

  // دالة لتجنب عرض HTML داخل الكود
  function escapeHtml(text) {
    return text
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
  }

  // إضافة event listeners للأزرار
  viewCodeButtons.forEach(button => {
    button.addEventListener('click', () => {
      const card = button.closest('.problem-card');
      const repo = card.dataset.repo;
      const path = card.dataset.path;
      openModal(repo, path);
    });
  });

  closeModalBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });
</script>