---
import Layout from '../layouts/Layout.astro';
const token = import.meta.env.GITHUB_TOKEN;
const username = 'Amr4924';
const url = `https://api.github.com/users/${username}/repos?sort=updated`;
let projects = [];
try {
    const response = await fetch(url, { headers: { Authorization: `token ${token}` } });
    if (response.ok) { projects = await response.json(); }
} catch (error) { console.error("Build-time fetch failed:", error); }
---
<Layout title="SA3DWY | المشاريع">
    <section id="projects">
        <h2 class="section-title">مشاريعي على GitHub</h2>
        <div id="projects-grid" class="projects-grid">
            {projects.length > 0 ? projects.map((project, index) => (
                <div class="project-card" data-aos="fade-up" data-aos-delay={index * 100}>
                    <h2>{project.name}</h2>
                    <p>{project.description || 'لا يوجد وصف لهذا المشروع.'}</p>
                    <div class="card-buttons">
                        <a href="#" class="btn btn-secondary view-code-btn" data-repo={project.name}>عرض الكود</a>
                        <a href={project.html_url} target="_blank" class="btn btn-primary">اذهب للمشروع</a>
                    </div>
                </div>
            )) : <div class="error-message"><h3>عفوًا، لم نتمكن من جلب المشاريع</h3></div>}
        </div>
    </section>
</Layout>

<script is:inline>
    // عناصر النافذة المنبثقة
    const modal = document.getElementById('code-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const copyCodeBtn = document.getElementById('copy-code-btn');

    const mainFileNames = ['main.cpp', 'main.py', 'index.js', 'script.js', 'app.js', 'index.html'];
    const priorityExtensions = ['.cpp', '.py', '.dart', '.js', '.java', '.cs', '.html'];
    
    function decodeBase64(content) { return decodeURIComponent(window.atob(content).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')); }

    async function showCodeContent(repoName, file) {
        // بما أننا جلبنا قائمة الملفات بالفعل، يمكننا الحصول على محتوى الملف مباشرة
        modalBody.innerHTML = '<p style="padding: 20px;">جاري تحميل الكود...</p>';
        try {
            // لا حاجة لطلب API جديد، المحتوى موجود في الكائن file
            // هذا يتطلب تعديل مسار الـ API ليجلب المحتوى أيضًا، لكن للتبسيط سنبقي على طلب API للمحتوى
            const contentResponse = await fetch(file.url); // Use the direct URL from the file object
            const data = await contentResponse.json();

            if (data.content) {
                const decodedContent = decodeBase64(data.content);
                const fileExtension = file.path.split('.').pop();
                modalBody.innerHTML = `<pre class="line-numbers language-${fileExtension}"><code>${decodedContent.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>`;
                Prism.highlightAll();
            }
        } catch (error) {
            modalBody.innerHTML = '<p style="padding: 20px;">لا يمكن عرض محتوى هذا الملف.</p>';
        }
    }

    async function showProjectCodeDirectly(repoName) {
        modalTitle.textContent = `عرض الكود للمشروع: ${repoName}`;
        modalBody.innerHTML = '<p style="padding: 20px;">جاري البحث عن الملفات...</p>';
        modal.style.display = 'flex';
        try {
            // ✨ الطلب الآن يذهب إلى مسار الـ API المحلي والآمن ✨
            const response = await fetch(`/api/getCode?repo=${repoName}`);
            if (!response.ok) throw new Error('API route failed');
            
            const files = await response.json();
            if (!Array.isArray(files)) {
                modalBody.innerHTML = '<p style="padding: 20px;">هذا المشروع فارغ.</p>';
                return;
            }

            let mainFile = files.find(file => mainFileNames.includes(file.name.toLowerCase()));
            if (!mainFile) {
                for (const ext of priorityExtensions) {
                    mainFile = files.find(file => file.name.toLowerCase().endsWith(ext));
                    if (mainFile) break;
                }
            }
            if (!mainFile) {
                mainFile = files.find(file => file.name.toLowerCase() === 'readme.md');
            }
            if (mainFile) {
                await showCodeContent(repoName, mainFile); // نمرر الكائن file بالكامل
            } else {
                 modalBody.innerHTML = '<p style="padding: 20px;">لا توجد ملفات قابلة للعرض.</p>';
            }
        } catch (error) {
            modalBody.innerHTML = '<p style="padding: 20px;">حدث خطأ أثناء جلب الملفات.</p>';
        }
    }

    document.getElementById('projects-grid').addEventListener('click', (e) => {
        const viewCodeBtn = e.target.closest('.view-code-btn');
        if (viewCodeBtn) {
            e.preventDefault();
            showProjectCodeDirectly(viewCodeBtn.dataset.repo);
        }
    });

    modalCloseBtn.addEventListener('click', () => modal.style.display = 'none');
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });

    copyCodeBtn.addEventListener('click', () => {
        const codeElement = modalBody.querySelector('pre code');
        if (codeElement) {
            navigator.clipboard.writeText(codeElement.textContent).then(() => {
                copyCodeBtn.querySelector('span').textContent = 'تم النسخ!';
                copyCodeBtn.classList.add('copied');
                setTimeout(() => {
                    copyCodeBtn.querySelector('span').textContent = 'نسخ الكود';
                    copyCodeBtn.classList.remove('copied');
                }, 2000);
            });
        }
    });
</script>