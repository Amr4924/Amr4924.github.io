---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import siteData from '../../data.json';

const flutterCount = siteData.projects.filter(p => p.category === 'flutter').length;
const webCount = siteData.projects.filter(p => p.category === 'web').length;
---
<Layout title="المشاريع — SA3DWY">
  <section class="page-head reveal">
    <span class="section-eyebrow">Work</span>
    <h1 class="section-title">المشاريع</h1>
    <p class="section-subtitle">كل مشروع ليه صفحة تفاصيل خاصة بيه: المشكلة، الحل، والتقنيات المستخدمة.</p>
  </section>

  <div class="projects-toolbar reveal" role="tablist" aria-label="تصنيف المشاريع">
    <button class="tab-btn is-active" data-filter="all">الكل ({siteData.projects.length})</button>
    <button class="tab-btn" data-filter="flutter">Flutter Apps ({flutterCount})</button>
    <button class="tab-btn" data-filter="web">Web Projects ({webCount})</button>
  </div>

  <div class="projects-grid reveal-group" id="projectsGrid">
    {siteData.projects.map((project: any, i: number) => (
      <div class="project-card-wrap" data-category={project.category}>
        <ProjectCard project={project} index={i} />
      </div>
    ))}
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card-wrap');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const filter = btn.dataset.filter;
        cards.forEach(card => {
          const match = filter === 'all' || card.dataset.category === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
