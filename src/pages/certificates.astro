---
import Layout from '../layouts/Layout.astro';
import siteData from '../../data.json';

const categories = [...new Set(siteData.certificates.map((c: any) => c.category))];
---
<Layout title={`الشهادات — ${siteData.handle}`}>
  <section class="page-head reveal">
    <span class="section-eyebrow">Certificates</span>
    <h1 class="section-title">الشهادات</h1>
    <p class="section-subtitle">شهادات من كورسات وبرامج تدريبية اشتركت فيها.</p>
  </section>

  {categories.map((cat: any) => (
    <div class="cert-group">
      <h2 class="cert-group__title">{cat}</h2>
      <div class="certificates-grid reveal-group">
        {siteData.certificates.filter((c: any) => c.category === cat).map((cert: any) => (
          <div class="certificate-card reveal">
            <a href={cert.imageUrl} target="_blank" rel="noopener noreferrer" class="certificate-image-link">
              <img src={cert.imageUrl} alt={cert.title} class="certificate-image" loading="lazy" />
            </a>
            <div class="certificate-content">
              <h3>{cert.title}</h3>
              <p>{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</Layout>
