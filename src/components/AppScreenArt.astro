---
// Abstract, stylized "app UI" illustration used as placeholder cover art
// for Flutter projects until real screenshots are swapped in.
// variant: 1 = list layout, 2 = grid/product layout, 3 = profile/detail layout
// tone: 'rose' | 'gold'
interface Props { variant?: 1 | 2 | 3; tone?: 'rose' | 'gold'; }
const { variant = 1, tone = 'rose' } = Astro.props;
const toneVar = tone === 'gold' ? 'var(--gold)' : 'var(--rose)';
const toneDim = tone === 'gold' ? 'var(--gold-dim)' : 'var(--rose-dim)';
---
<svg class="app-screen-art" viewBox="0 0 220 460" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role="img" aria-label="واجهة تطبيق توضيحية">
  <rect width="220" height="460" fill="var(--surface)" />
  <rect x="0" y="0" width="220" height="46" fill="var(--surface-2)" />
  <circle cx="26" cy="23" r="10" fill={toneVar} opacity="0.85" />
  <rect x="46" y="16" width="60" height="6" rx="3" fill="var(--text-dim)" />
  <rect x="46" y="27" width="38" height="5" rx="2.5" fill="var(--border)" />
  <circle cx="196" cy="23" r="9" fill="var(--surface)" stroke="var(--border)" stroke-width="1.5" />

  {variant === 1 && (
    <>
      <rect x="16" y="66" width="188" height="112" rx="14" fill={toneDim} stroke={toneVar} stroke-opacity="0.35" />
      <rect x="30" y="150" width="90" height="8" rx="4" fill={toneVar} opacity="0.8" />
      {[0, 1, 2].map(i => (
        <g transform={`translate(16, ${196 + i * 66})`}>
          <rect width="188" height="54" rx="12" fill="var(--surface-2)" stroke="var(--border-soft)" />
          <rect x="14" y="14" width="26" height="26" rx="8" fill={toneVar} opacity={0.5 - i * 0.1} />
          <rect x="50" y="18" width="100" height="7" rx="3.5" fill="var(--text-dim)" />
          <rect x="50" y="31" width="60" height="6" rx="3" fill="var(--border)" />
        </g>
      ))}
    </>
  )}

  {variant === 2 && (
    <>
      <rect x="16" y="64" width="188" height="30" rx="15" fill="var(--surface-2)" stroke="var(--border-soft)" />
      <circle cx="34" cy="79" r="6" fill="var(--text-dim)" />
      <rect x="48" y="75" width="80" height="8" rx="4" fill="var(--border)" />
      {[0, 1, 2, 3].map(i => (
        <g transform={`translate(${16 + (i % 2) * 96}, ${110 + Math.floor(i / 2) * 128})`}>
          <rect width="88" height="118" rx="14" fill="var(--surface-2)" stroke="var(--border-soft)" />
          <rect x="10" y="10" width="68" height="68" rx="10" fill={toneDim} stroke={toneVar} stroke-opacity="0.3" />
          <rect x="10" y="88" width="52" height="7" rx="3.5" fill="var(--text-dim)" />
          <rect x="10" y="100" width="34" height="6" rx="3" fill={toneVar} opacity="0.7" />
        </g>
      ))}
    </>
  )}

  {variant === 3 && (
    <>
      <circle cx="110" cy="120" r="38" fill={toneDim} stroke={toneVar} stroke-opacity="0.4" stroke-width="2" />
      <rect x="70" y="172" width="80" height="9" rx="4.5" fill="var(--text-dim)" />
      <rect x="86" y="188" width="48" height="6" rx="3" fill="var(--border)" />
      <g transform="translate(16, 216)">
        <rect width="188" height="56" rx="14" fill="var(--surface-2)" stroke="var(--border-soft)" />
        {[0, 1, 2].map(i => (
          <g transform={`translate(${20 + i * 64}, 14)`}>
            <rect width="44" height="10" rx="5" fill={toneVar} opacity="0.75" />
            <rect y="18" width="34" height="6" rx="3" fill="var(--border)" />
          </g>
        ))}
      </g>
      {[0, 1].map(i => (
        <g transform={`translate(16, ${288 + i * 64})`}>
          <rect width="188" height="50" rx="12" fill="var(--surface-2)" stroke="var(--border-soft)" />
          <rect x="14" y="12" width="24" height="24" rx="7" fill={toneVar} opacity={0.5 - i * 0.15} />
          <rect x="48" y="16" width="110" height="7" rx="3.5" fill="var(--text-dim)" />
          <rect x="48" y="29" width="70" height="6" rx="3" fill="var(--border)" />
        </g>
      ))}
    </>
  )}

  <rect x="0" y="430" width="220" height="30" fill="var(--surface-2)" />
  {[0, 1, 2, 3].map(i => (
    <circle cx={44 + i * 44} cy="445" r={i === 0 ? 7 : 5} fill={i === 0 ? toneVar : 'var(--border)'} />
  ))}
</svg>
