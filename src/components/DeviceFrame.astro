---
import AppScreenArt from './AppScreenArt.astro';
import CoverArt from './CoverArt.astro';
// Renders a project's preview: phone frame (Flutter) or browser frame (Web).
// Shows `image` if given, otherwise the project's cover (first gallery image),
// otherwise the abstract placeholder art. Pass image="" to force the placeholder.
interface Props { project: any; variant?: 1 | 2 | 3; size?: 'card' | 'large'; image?: string; alt?: string; }
const { project, variant = 1, size = 'card', image, alt } = Astro.props;
const isFlutter = project.category === 'flutter';
const cover: string = (Array.isArray(project.images) && project.images[0]) || project.image || '';
const src: string = image !== undefined ? image : cover;
const large = size === 'large';
---
{isFlutter ? (
  <div class:list={["project-card__phone-wrap", large && "is-large"]}>
    <div class:list={["device-frame--phone", large ? "is-large phone-float--soft" : "is-card"]}>
      <div class="notch"></div>
      <div class="screen">
        {src
          ? <img src={src} alt={alt ?? project.name} class="real-screenshot" loading="lazy" decoding="async" />
          : <AppScreenArt variant={variant} tone={project.coverTone} />}
      </div>
    </div>
  </div>
) : (
  <div class="project-card__media is-web">
    <div class="browser-frame">
      <div class="browser-frame__bar"><span></span><span></span><span></span></div>
      <div class="browser-frame__body">
        {src
          ? <img src={src} alt={alt ?? project.name} class="real-screenshot" loading="lazy" decoding="async" />
          : <CoverArt icon={project.coverIcon} label={project.name} tone={project.coverTone} />}
      </div>
    </div>
  </div>
)}
